# --- Required ---
EVOLINK_API_TOKEN=replace-me

# Host folder your Chrome extension downloads screenshots into. This is the
# only value that differs between machines; inside the container it is always
# mounted at /watch.
#   macOS:  /Users/you/Downloads/TikTok Live
#   Ubuntu: /home/ubuntu/Downloads/TikTok Live
HOST_WATCH_DIR=/home/ubuntu/Downloads/TikTok Live

# --- Model ---
EVOLINK_MODEL_NAME=gemini-3.5-flash-lite
# Leave unset to derive the URL from EVOLINK_MODEL_NAME. Setting it pins the
# full endpoint and makes EVOLINK_MODEL_NAME have no effect.
# EVOLINK_URL=https://direct.evolink.ai/v1beta/models/gemini-3.5-flash-lite:generateContent

# --- Watch strategy ---
# auto    - detect from the filesystem type (inotify on Linux, polling on
#           Docker Desktop bind mounts and network shares)
# native  - force inotify/FSEvents
# polling - force polling
WATCHER_OBSERVER=auto
WATCHER_POLL_INTERVAL=5

# --- PocketBase ---
POCKETBASE_COLLECTION_NAME=auction_items
PB_VERSION=0.39.10

# Numeric owner of the bind-mounted folders. Required on Linux, ignored by
# Docker Desktop. `id -u` / `id -g` on the host.
PUID=1000
PGID=1000

# --- Running without Docker only ---
# In compose these are set by the stack and ignored from here.
# WATCH_DIRECTORY=/home/ubuntu/Downloads/TikTok Live
# POCKETBASE_URL=http://127.0.0.1:8090
# STATE_DIR=./state
